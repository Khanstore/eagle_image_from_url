<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="eagle_product_image_url_view" model="ir.ui.view">
            <field name="name">product.product.form.eagle.image.url</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="image_url"/>
                </xpath>
            </field>
        </record>

        <record id="eagle_product_variant_image_url_view" model="ir.ui.view">
            <field name="name">product.variant.form.eagle.image.url</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[2]" position="after">
                    <group col="4">
                        <group>
                            <field name="image_url"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="eagle_product_template_image_url_view" model="ir.ui.view">
            <field name="name">product.template.form.eagle.image.url</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="image_url_template"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
